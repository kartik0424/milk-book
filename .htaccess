# MilkBook - Apache Web Security (.htaccess)
# Denies direct web access to backend PHP code, config, database schema, and raw data files

# 1. Disable directory listings
Options -Indexes

# 2. Block access to sensitive directories
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|includes|database|tests)/ - [F,L]
</IfModule>

# 3. Block access to hidden files and specific file extensions
<FilesMatch "(^\.|\.(sql|md|log|env|bak|ini))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
